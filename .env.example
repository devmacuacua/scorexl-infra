# =========================
# POSTGRES — shared user, per-sport DB name + password
# =========================
# Standardized to `scorexl` everywhere (was `scorexl` on football/nba,
# `postgres` on basketball/web in the 4 legacy repos) — one shared user
# across all 5 Postgres containers. DB name and password stay per-sport so a
# leaked/rotated credential for one sport doesn't affect the others, even
# though they share a user name.
POSTGRES_USER=scorexl

FOOTBALL_POSTGRES_DB=scorexl_football
FOOTBALL_POSTGRES_PASSWORD=changeme

BASKETBALL_POSTGRES_DB=scorexl_basketball
BASKETBALL_POSTGRES_PASSWORD=changeme

NBA_POSTGRES_DB=scorexl_nba
NBA_POSTGRES_PASSWORD=changeme

VOLLEYBALL_POSTGRES_DB=scorexl_volleyball
VOLLEYBALL_POSTGRES_PASSWORD=changeme

# scorexl-user-api's DB name is hardcoded (scorexl_user) in docker-compose.yml,
# only the password is configurable here — matches the legacy web-infra repo.
USER_POSTGRES_PASSWORD=changeme

# =========================
# INTERNAL AUTH
# =========================
# Shared across every sport's api + web's user-api, same as in all 4 legacy
# repos.
INTERNAL_API_KEY=your_internal_key_here

# =========================
# API-SPORTS.IO KEYS
# =========================
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_API_KEY=your_key_here

API_BASKETBALL_KEY=your_api_key_here

API_NBA_KEY=your_api_key_here

# Volleyball reuses the same api-sports.io account key as the other sports —
# confirmed this session that one key works across every api-sports.io
# product on the account (football/basketball/nba/volleyball all live under
# the same account), so this does not need to be a separately-issued key.
API_VOLLEYBALL_API_KEY=your_key_here

# =========================
# FOOTBALL — PREDICTION / PIPELINE TUNING
# =========================
PREDICTION_MATCH_WINNER_HIGH_RISK_MODE_ENABLED=true
BACKTEST_PIPELINE_CHUNK_SIZE=50

# =========================
# FOOTBALL — MICROSERVICES (engine URLs)
# =========================
# handicap, over-under, btts, match-winner, double-chance, team-over-goals,
# corners, cards, shots, fouls were merged into scorexl-football-api itself
# 2026-07-23 — no longer separate services. live-opportunities stays
# separate (stateful: own datasource/scheduler).
SCOREXL_ENGINES_LIVE_OPPORTUNITIES_URL=http://scorexl-football-live-opportunities-engine:4005

# =========================
# FOOTBALL — LIVE ENGINE (separate DB, same postgres container)
# =========================
SPRING_FOOTBALL_LIVE_DATASOURCE_URL=jdbc:postgresql://scorexl-football-postgres:5432/scorexl_football_live
SPRING_FOOTBALL_LIVE_DATASOURCE_USERNAME=scorexl
SPRING_FOOTBALL_LIVE_DATASOURCE_PASSWORD=changeme

# Engine's own internal sweep stays off — football-api's LiveOpportunityTriggerService
# (SCOREXL_LIVE_OPPORTUNITIES_ENABLED below) now decides when/which fixtures to check.
SCOREXL_LIVE_SCHEDULER_ENABLED=false
SCOREXL_LIVE_SCHEDULER_DELAY_MS=60000

# Off by default — only flip on once API-Football quota headroom is confirmed.
SCOREXL_LIVE_OPPORTUNITIES_ENABLED=false

# Max distinct live fixtures monitored concurrently ("HOT GAMES") — this, not
# the number of users, is what bounds API-Football quota usage under v2's
# user-opt-in monitoring.
SCOREXL_LIVE_MAX_HOT_GAMES=3

# =========================
# BASKETBALL — MICROSERVICES
# =========================
# All 10 engines were merged into scorexl-basketball-api itself
# 2026-07-23 — no separate engine services left for this sport.

# =========================
# NBA — MICROSERVICES
# =========================
# All 12 active engines were merged into scorexl-nba-api itself
# 2026-07-23 — no separate engine services left for this sport.

# =========================
# VOLLEYBALL — MICROSERVICES
# =========================
# winner-engine (the only one this consolidated file ever had) was merged
# into scorexl-volleyball-api itself 2026-07-23 — no separate engine
# service left for this sport.

# =========================
# WEB
# =========================
NODE_ENV=production
PORT=3000

# API URLs (production)
NEXT_PUBLIC_SCOREXL_API_URL=https://api.scorexl.com/api/v1
SCOREXL_API_URL=https://api.scorexl.com
SCOREXL_BASKETBALL_API_URL=https://basketball-api.scorexl.com
SCOREXL_NBA_API_URL=https://nba-api.scorexl.com
SCOREXL_TENNIS_API_URL=https://tennis-api.scorexl.com
SCOREXL_VOLLEYBALL_API_URL=https://volleyball-api.scorexl.com
# SCOREXL_NFL_API_URL=https://nfl-api.scorexl.com
# SCOREXL_BASEBALL_API_URL=https://baseball-api.scorexl.com

# Auth (NextAuth v5 + Google OAuth) — required, otherwise /api/auth/session
# returns 500 "There was a problem with the server configuration"
AUTH_SECRET=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# =========================
# WEB PUSH — VAPID
# =========================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@scorexl.com

# =========================
# USER API
# =========================
CORS_ALLOWED_ORIGINS=https://scorexl.com

# =========================
# DEV ONLY
# =========================
GITHUB_ACTOR=
GH_PACKAGES_TOKEN=
