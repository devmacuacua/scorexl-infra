# ScoreXL — produção. Copia para .env e preenche os <...>.

# Base de dados
POSTGRES_USER=scorexl
BACKEND_POSTGRES_PASSWORD=<openssl rand -hex 24>

# Backend
# chave do servidor do site para o módulo user do backend (os dois leem daqui)
INTERNAL_API_KEY=<openssl rand -hex 24>
# client IDs OAuth do Google aceites nos tokens da app (web, Android, iOS; separados por vírgula)
GOOGLE_CLIENT_IDS=<GOOGLE_CLIENT_ID>,<client ID Android>,<client ID iOS>
CORS_ALLOWED_ORIGINS=https://scorexl.com,https://www.scorexl.com
# só com 2 GB de RAM; com 4 GB apaga a linha
BACKEND_JAVA_TOOL_OPTIONS=-Xmx768m -XX:MaxMetaspaceSize=320m -Xss512k

# Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=<...>
VAPID_PRIVATE_KEY=<...>
VAPID_EMAIL=mailto:devmacuacua@gmail.com

# Web: login
AUTH_URL=https://scorexl.com
AUTH_TRUST_HOST=1
AUTH_SECRET=<openssl rand -base64 32>
GOOGLE_CLIENT_ID=<Google Cloud Console>
GOOGLE_CLIENT_SECRET=<Google Cloud Console>

# Web: admin e cron
ADMIN_KEY=<openssl rand -hex 24>
CRON_SECRET=<openssl rand -hex 24>

# Web: analytics
UMAMI_SCRIPT_URL=https://analytics.scorexl.com/script.js
UMAMI_WEBSITE_ID=<id do site no umami>

# Umami
UMAMI_POSTGRES_DB=scorexl_umami
UMAMI_POSTGRES_PASSWORD=<openssl rand -hex 24>
UMAMI_APP_SECRET=<openssl rand -hex 24>

# Imagens (GHCR) — PAT com read:packages; o deploy.sh faz o login
GH_PACKAGES_TOKEN=<...>

# Opcionais
# EXPO_ACCESS_TOKEN=          # só com "enhanced push security" ligado na Expo
# PICKS_FEED_URL=             # padrão: raw.githubusercontent.com/devmacuacua/scorexl-picks/main
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# GUARDIAN_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# INSTAGRAM_ACCESS_TOKEN=
