# =========================
# POSTGRES — shared user, per-sport DB name + password
# =========================
# Standardized to `scorexl` everywhere (was `scorexl` on football/nba,
# `postgres` on basketball/web in the 4 legacy repos) — one shared user
# across all 5 Postgres containers. DB name and password stay per-sport so a
# leaked/rotated credential for one sport doesn't affect the others, even
# though they share a user name.
POSTGRES_USER=scorexl

FOOTBALL_POSTGRES_DB=scorexl_football
FOOTBALL_POSTGRES_PASSWORD=changeme

BASKETBALL_POSTGRES_DB=scorexl_basketball
BASKETBALL_POSTGRES_PASSWORD=changeme

NBA_POSTGRES_DB=scorexl_nba
NBA_POSTGRES_PASSWORD=changeme

VOLLEYBALL_POSTGRES_DB=scorexl_volleyball
VOLLEYBALL_POSTGRES_PASSWORD=changeme

# scorexl-user-api's DB name is hardcoded (scorexl_user) in docker-compose.yml,
# only the password is configurable here — matches the legacy web-infra repo.
USER_POSTGRES_PASSWORD=changeme

# =========================
# INTERNAL AUTH
# =========================
# Shared across every sport's api + web's user-api, same as in all 4 legacy
# repos.
INTERNAL_API_KEY=your_internal_key_here

# =========================
# API-SPORTS.IO KEYS
# =========================
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_API_KEY=your_key_here

API_BASKETBALL_KEY=your_api_key_here

API_NBA_KEY=your_api_key_here

# Volleyball reuses the same api-sports.io account key as the other sports —
# confirmed this session that one key works across every api-sports.io
# product on the account (football/basketball/nba/volleyball all live under
# the same account), so this does not need to be a separately-issued key.
API_VOLLEYBALL_API_KEY=your_key_here

# =========================
# FOOTBALL — PREDICTION / PIPELINE TUNING
# =========================
PREDICTION_MATCH_WINNER_HIGH_RISK_MODE_ENABLED=true
BACKTEST_PIPELINE_CHUNK_SIZE=50

# =========================
# FOOTBALL — MICROSERVICES (engine URLs)
# =========================
# Configured via .env rather than hardcoded in docker-compose.yml — this was
# already football's convention in the legacy repo; now applied to every
# other sport's engines below too.
SCOREXL_ENGINES_HANDICAP_URL=http://scorexl-football-handicap-engine:4001
SCOREXL_ENGINES_OVER_UNDER_URL=http://scorexl-football-over-under-engine:4002
SCOREXL_ENGINES_BTTS_URL=http://scorexl-football-btts-engine:4003
SCOREXL_ENGINES_MATCH_WINNER_URL=http://scorexl-football-match-winner-engine:4004
SCOREXL_ENGINES_LIVE_OPPORTUNITIES_URL=http://scorexl-football-live-opportunities-engine:4005
SCOREXL_ENGINES_DOUBLE_CHANCE_URL=http://scorexl-football-double-chance-engine:4007
SCOREXL_ENGINES_TEAM_OVER_GOALS_URL=http://scorexl-football-team-over-goals-engine:4010
SCOREXL_ENGINES_CORNERS_URL=http://scorexl-football-corners-engine:4006
SCOREXL_ENGINES_CARDS_URL=http://scorexl-football-cards-engine:4008
SCOREXL_ENGINES_SHOTS_URL=http://scorexl-football-shots-engine:4009
SCOREXL_ENGINES_FOULS_URL=http://scorexl-football-fouls-engine:4011

# =========================
# FOOTBALL — LIVE ENGINE (separate DB, same postgres container)
# =========================
SPRING_FOOTBALL_LIVE_DATASOURCE_URL=jdbc:postgresql://scorexl-football-postgres:5432/scorexl_football_live
SPRING_FOOTBALL_LIVE_DATASOURCE_USERNAME=scorexl
SPRING_FOOTBALL_LIVE_DATASOURCE_PASSWORD=changeme

# Engine's own internal sweep stays off — football-api's LiveOpportunityTriggerService
# (SCOREXL_LIVE_OPPORTUNITIES_ENABLED below) now decides when/which fixtures to check.
SCOREXL_LIVE_SCHEDULER_ENABLED=false
SCOREXL_LIVE_SCHEDULER_DELAY_MS=60000

# Off by default — only flip on once API-Football quota headroom is confirmed.
SCOREXL_LIVE_OPPORTUNITIES_ENABLED=false

# Max distinct live fixtures monitored concurrently ("HOT GAMES") — this, not
# the number of users, is what bounds API-Football quota usage under v2's
# user-opt-in monitoring.
SCOREXL_LIVE_MAX_HOT_GAMES=3

# =========================
# BASKETBALL — MICROSERVICES (engine URLs)
# =========================
# Previously hardcoded directly in scorexl-basketball-infra's
# docker-compose.yml — moved here to match football's convention.
BASKETBALL_WINNER_ENGINE_URL=http://scorexl-basketball-winner-engine:5001
BASKETBALL_SPREAD_ENGINE_URL=http://scorexl-basketball-spread-engine:5002
BASKETBALL_TOTALS_ENGINE_URL=http://scorexl-basketball-totals-engine:5003
BASKETBALL_FIRST_HALF_TOTALS_ENGINE_URL=http://scorexl-basketball-first-half-totals-engine:5004
BASKETBALL_FIRST_HALF_SPREAD_ENGINE_URL=http://scorexl-basketball-first-half-spread-engine:5005
BASKETBALL_FIRST_QUARTER_TOTALS_ENGINE_URL=http://scorexl-basketball-first-quarter-totals-engine:5006
BASKETBALL_FIRST_QUARTER_SPREAD_ENGINE_URL=http://scorexl-basketball-first-quarter-spread-engine:5007
BASKETBALL_FIRST_HALF_WINNER_ENGINE_URL=http://scorexl-basketball-first-half-winner-engine:5008
BASKETBALL_TEAM_TOTALS_ENGINE_URL=http://scorexl-basketball-team-totals-engine:5009
BASKETBALL_FIRST_QUARTER_WINNER_ENGINE_URL=http://scorexl-basketball-first-quarter-winner-engine:5010

# =========================
# NBA — MICROSERVICES (engine URLs)
# =========================
# Previously hardcoded directly in scorexl-nba-infra's docker-compose.yml —
# moved here to match football's convention.
NBA_WINNER_ENGINE_URL=http://scorexl-nba-winner-engine:7001
NBA_SPREAD_ENGINE_URL=http://scorexl-nba-spread-engine:7002
NBA_TOTALS_ENGINE_URL=http://scorexl-nba-totals-engine:7003
NBA_FIRST_HALF_WINNER_ENGINE_URL=http://scorexl-nba-first-half-winner-engine:7004
NBA_FIRST_HALF_TOTALS_ENGINE_URL=http://scorexl-nba-first-half-totals-engine:7005
NBA_FIRST_QUARTER_WINNER_ENGINE_URL=http://scorexl-nba-first-quarter-winner-engine:7006
NBA_FIRST_QUARTER_TOTALS_ENGINE_URL=http://scorexl-nba-first-quarter-totals-engine:7007
NBA_TEAM_TOTALS_ENGINE_URL=http://scorexl-nba-team-totals-engine:7008
NBA_TEAM_REBOUNDS_ENGINE_URL=http://scorexl-nba-team-rebounds-engine:7009
NBA_TEAM_ASSISTS_ENGINE_URL=http://scorexl-nba-team-assists-engine:7010
NBA_TEAM_THREES_ENGINE_URL=http://scorexl-nba-team-threes-engine:7011
NBA_TEAM_TURNOVERS_ENGINE_URL=http://scorexl-nba-team-turnovers-engine:7012

# =========================
# VOLLEYBALL — MICROSERVICES (engine URL)
# =========================
VOLLEYBALL_WINNER_ENGINE_URL=http://scorexl-volleyball-winner-engine:8001

# =========================
# WEB
# =========================
NODE_ENV=production
PORT=3000

# API URLs (production)
NEXT_PUBLIC_SCOREXL_API_URL=https://api.scorexl.com/api/v1
SCOREXL_API_URL=https://api.scorexl.com
SCOREXL_BASKETBALL_API_URL=https://basketball-api.scorexl.com
SCOREXL_NBA_API_URL=https://nba-api.scorexl.com
SCOREXL_TENNIS_API_URL=https://tennis-api.scorexl.com
SCOREXL_VOLLEYBALL_API_URL=https://volleyball-api.scorexl.com
# SCOREXL_NFL_API_URL=https://nfl-api.scorexl.com
# SCOREXL_BASEBALL_API_URL=https://baseball-api.scorexl.com

# Auth (NextAuth v5 + Google OAuth) — required, otherwise /api/auth/session
# returns 500 "There was a problem with the server configuration"
AUTH_SECRET=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# =========================
# WEB PUSH — VAPID
# =========================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@scorexl.com

# =========================
# USER API
# =========================
CORS_ALLOWED_ORIGINS=https://scorexl.com

# =========================
# DEV ONLY
# =========================
GITHUB_ACTOR=
GH_PACKAGES_TOKEN=
