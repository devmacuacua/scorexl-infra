# SHARED
POSTGRES_USER=scorexl
INTERNAL_API_KEY=your_internal_key_here

# WEB
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_SCOREXL_API_URL=https://api.scorexl.com/api/v1
SCOREXL_API_URL=https://api.scorexl.com
SCOREXL_BASKETBALL_API_URL=https://basketball-api.scorexl.com
SCOREXL_NBA_API_URL=https://nba-api.scorexl.com
SCOREXL_TENNIS_API_URL=https://tennis-api.scorexl.com
SCOREXL_VOLLEYBALL_API_URL=https://volleyball-api.scorexl.com
SCOREXL_MLB_API_URL=https://mlb-api.scorexl.com
SCOREXL_AFL_API_URL=https://afl-api.scorexl.com
SCOREXL_NFL_API_URL=https://nfl-api.scorexl.com
SCOREXL_NHL_API_URL=https://nhl-api.scorexl.com
SCOREXL_RUGBY_API_URL=https://rugby-api.scorexl.com
SCOREXL_HANDBALL_API_URL=https://handball-api.scorexl.com
SCOREXL_F1_API_URL=https://f1-api.scorexl.com
SCOREXL_MMA_API_URL=https://mma-api.scorexl.com
SCOREXL_USER_API_URL=http://scorexl-user-api:9000
AUTH_URL=https://scorexl.com
AUTH_TRUST_HOST=1
AUTH_SECRET=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
CRON_SECRET=CHANGE_ME
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@scorexl.com

# Umami (self-hosted analytics, see docker-compose's scorexl-umami service).
# UMAMI_WEBSITE_ID doesn't exist until a website is registered in the Umami
# dashboard (https://analytics.scorexl.com) after first deploy — leave it
# blank until then; the web app's tracking script is a no-op with it unset.
UMAMI_SCRIPT_URL=https://analytics.scorexl.com/script.js
UMAMI_WEBSITE_ID=

# EXTERNAL API (GHCR — pulling private images)
GITHUB_ACTOR=
GH_PACKAGES_TOKEN=

# FOOTBALL
# DB name is "scorexl" (not "scorexl_football") — football was the only
# sport when this was first set up, before the per-sport naming convention.
FOOTBALL_POSTGRES_DB=scorexl
FOOTBALL_POSTGRES_PASSWORD=changeme
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_API_KEY=your_key_here
PREDICTION_MATCH_WINNER_HIGH_RISK_MODE_ENABLED=true
BACKTEST_PIPELINE_CHUNK_SIZE=50
SCOREXL_ENGINES_LIVE_OPPORTUNITIES_URL=http://scorexl-football-live-opportunities-engine:4005
SPRING_FOOTBALL_LIVE_DATASOURCE_URL=jdbc:postgresql://scorexl-football-postgres:5432/scorexl_football_live
SPRING_FOOTBALL_LIVE_DATASOURCE_USERNAME=scorexl
SPRING_FOOTBALL_LIVE_DATASOURCE_PASSWORD=changeme
SCOREXL_LIVE_SCHEDULER_ENABLED=false
SCOREXL_LIVE_SCHEDULER_DELAY_MS=60000
SCOREXL_LIVE_OPPORTUNITIES_ENABLED=false
SCOREXL_LIVE_MAX_HOT_GAMES=3

# BASKETBALL
BASKETBALL_POSTGRES_DB=scorexl_basketball
BASKETBALL_POSTGRES_PASSWORD=changeme
API_BASKETBALL_KEY=your_api_key_here

# NBA
NBA_POSTGRES_DB=scorexl_nba
NBA_POSTGRES_PASSWORD=changeme
API_NBA_KEY=your_api_key_here

# VOLLEYBALL
VOLLEYBALL_POSTGRES_DB=scorexl_volleyball
VOLLEYBALL_POSTGRES_PASSWORD=changeme
API_VOLLEYBALL_API_KEY=your_key_here

# MLB
MLB_POSTGRES_DB=scorexl_mlb
MLB_POSTGRES_PASSWORD=changeme
API_MLB_API_KEY=your_key_here

# AFL
AFL_POSTGRES_DB=scorexl_afl
AFL_POSTGRES_PASSWORD=changeme
API_AFL_API_KEY=your_key_here

# NFL
NFL_POSTGRES_DB=scorexl_nfl
NFL_POSTGRES_PASSWORD=changeme
API_NFL_API_KEY=your_key_here

# NHL
NHL_POSTGRES_DB=scorexl_nhl
NHL_POSTGRES_PASSWORD=changeme
API_NHL_API_KEY=your_key_here

# Rugby
RUGBY_POSTGRES_DB=scorexl_rugby
RUGBY_POSTGRES_PASSWORD=changeme
API_RUGBY_API_KEY=your_key_here
# api-sports.io league.id allowlist (comma-separated) — rugby has ~143
# competitions under one feed, unlike other sports' single hardcoded league.
# Default: Currie Cup (37), confirmed live 2026-07-24.
RUGBY_LEAGUE_IDS=37

# Handball
HANDBALL_POSTGRES_DB=scorexl_handball
HANDBALL_POSTGRES_PASSWORD=changeme
API_HANDBALL_API_KEY=your_key_here
# api-sports.io league.id allowlist (comma-separated). Confirmed live
# 2026-07-24 via a real /leagues call — id=39 is Germany's Bundesliga (the
# most competitive handball league globally, best bookmaker odds coverage).
# Other solid options seen in the same response: 131 = EHF Champions League,
# 103 = Spain Liga ASOBAL, 34 = France Starligue. Add more comma-separated
# as needed.
HANDBALL_LEAGUE_IDS=39

# Formula-1 — predictions only, no odds (/odds does not exist on this
# provider at all). No league-id filtering: v1.formula-1's /races is a
# single global championship calendar per season.
F1_POSTGRES_DB=scorexl_f1
F1_POSTGRES_PASSWORD=changeme
API_F1_API_KEY=your_key_here

# MMA — predictions only. /odds exists but returned zero actual odds rows
# for every fight tried (Free-plan coverage gap). No league-id filtering:
# v1.mma's /fights is synced by season across all promotions/events.
MMA_POSTGRES_DB=scorexl_mma
MMA_POSTGRES_PASSWORD=changeme
API_MMA_API_KEY=your_key_here

# USER API
USER_POSTGRES_PASSWORD=changeme
CORS_ALLOWED_ORIGINS=https://scorexl.com

# Umami analytics DB
UMAMI_POSTGRES_DB=umami
UMAMI_POSTGRES_PASSWORD=changeme
# Umami's own hash/session secret — any long random string, generate with
# e.g. `openssl rand -hex 32`. Unrelated to POSTGRES_PASSWORD above.
UMAMI_APP_SECRET=changeme
